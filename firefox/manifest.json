{
  "manifest_version": 2,
  "name": "MyExt",
  "version": "1.0",
  "description": "Personal Firefox extension: LinkedIn job sidebar info, YouTube playlist thumbnail view, and YouTube search across bookmarks/history",
  "permissions": [
    "activeTab",
    "tabs",
    "bookmarks",
    "history",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_title": "Job Summary",
    "default_panel": "sidebar.html",
    "default_icon": "icon.svg"
  },
  "browser_action": {
    "default_title": "MyExt",
    "default_popup": "popup.html",
    "default_icon": "yt-icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/view/*",
        "https://www.linkedin.com/jobs/search/*"
      ],
      "js": ["extractor.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "myext@local",
      "strict_min_version": "109.0"
    }
  }
}
